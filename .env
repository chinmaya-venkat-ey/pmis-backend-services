# pmis-user-management â€” example local-dev env.
# Copy to `.env` in the same directory and fill in real values.

# === Cross-service ===
ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ROOT_PATH=/users
SERVICE_NAME=pmis-user-management
CORS_ORIGINS=http://localhost:3000

# === DB ===
# Local Postgres (the four services share the same DB; each owns one schema).
DATABASE_URL=postgresql+psycopg2://pmis_user:aadhaarpmis2026@10.1.131.199:5432/pmis_db
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://pmis_user:aadhaarpmis2026@10.1.131.199:5432/pmis_db

# === JWT (CRITICAL: must be byte-identical across all 4 services) ===
SECRET_KEY=dev-smoke-test-secret-key-pmis-2026-05-15-32chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_GRACE_SECONDS=120

# === Bootstrap (consumed ONLY by the first alembic upgrade) ===
BOOTSTRAP_SUPERADMIN_LOGIN=superadmin
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@local.dev
SUPERADMIN_BOOTSTRAP_PASSWORD=DevAdmin123!
# After the first migration completes successfully, REMOVE the password line above.

# === 2FA / OTP (round-7: dev backdoor enabled) ===
REQUIRE_2FA=true
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=6
OTP_HASH_PEPPER=local-dev-pepper-CHANGE-ME
PASSWORD_RESET_TTL_SECONDS=3600

# DEV ONLY: skip real OTP delivery by accepting `000000` as the OTP.
# Q14 enforces a HARD startup error if this is true with ENV=production.
UNIVERSAL_OTP_ENABLED=true
UNIVERSAL_OTP_CODE=000000

# === Outbound to notification-svc ===
NOTIFICATION_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_TIMEOUT_SECONDS=10.0
# `mock` skips the HTTP hop and just writes the audit row. Switch to `http`
# when you want to drive the real notification-svc dispatch path.
NOTIFICATION_CLIENT=mock

# === Pagination ===
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
