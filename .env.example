# pmis-project-management — example local-dev env.

ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ROOT_PATH=
SERVICE_NAME=pmis-project-management
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg2://pmis_app:CHANGE-ME-IN-PROD@localhost:5432/pmis
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://pmis_ddl:CHANGE-ME-IN-PROD@localhost:5432/pmis

# JWT verify-only. SECRET_KEY MUST be byte-identical to user-svc's.
SECRET_KEY=local-dev-secret-CHANGE-ME-min-32-chars-please-xxxxx
ALGORITHM=HS256

# === Attachments (round-7: NFS in prod, local folder in dev) ===
# Dev: a folder under the repo. Prod: an NFS mount point (server 10.1.131.199).
# Either way the app just sees a folder path.
ATTACHMENTS_STORAGE_BASE_PATH=C:/tmp/pmis-attachments-dev
ATTACHMENTS_MAX_BYTES=26214400
ATTACHMENTS_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,jpg,jpeg,png,heic,mp4,webm,mov
ATTACHMENTS_SUBDIR_STRATEGY=year_month
ATTACHMENTS_RETENTION_DAYS=90
ATTACHMENTS_ON_UNAVAILABLE=fail

# Dev: leave FILE_SERVER_PUBLIC_BASE_URL blank to use the fallback
# `GET /files/{key}` route. Prod: set to the NFS host's HTTP front
# (e.g. http://10.1.131.199).
FILE_SERVER_PUBLIC_BASE_URL=
FILE_SERVER_LOCAL_FALLBACK_ENABLED=true
FILE_SERVER_BASE_URL=
FILE_SERVER_AUTH_TOKEN=

FRONTEND_BASE_URL=http://localhost:3000

# === Activity Workflow (external Java microservice) ===
# Leave WORKFLOW_SERVICE_URL blank to operate in mock mode (the inbox
# detail returns synthetic Java history; transitions are no-ops).
WORKFLOW_SERVICE_URL=
WORKFLOW_SERVICE_TIMEOUT_SECONDS=10
# real | mock — override the auto mode (auto = real if URL set).
WORKFLOW_CLIENT=

# === Notification dispatch (PMIS-notification-service) ===
# Used by the approval-inbox transition proxy. Leave blank for mock mode.
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_TIMEOUT_SECONDS=5
NOTIFICATION_CLIENT=

# === User management (PMIS-user-management) ===
# Used by team-page save to forward orgUser changes to user-mgmt's
# bulk-replace role-assignment endpoint. The caller's JWT is forwarded
# verbatim so user-mgmt enforces project_members:update against the
# actual caller. Leave blank for mock mode (orgUser diff is logged and
# skipped; local writes still proceed).
USER_MANAGEMENT_SERVICE_URL=http://10.1.131.199/users
USER_MANAGEMENT_SERVICE_TIMEOUT_SECONDS=5
USER_MANAGEMENT_CLIENT=

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
