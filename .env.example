# ========================================
# PIMS-NOTIFICATION SERVICE CONFIGURATION
# ========================================

# ---- App ----
APP_NAME=PIMS-NOTIFICATION
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
API_PREFIX=/api/v1

# ---- Logging ----
LOG_LEVEL=INFO

# ---- CORS ----
CORS_ORIGINS=*

# ---- Email Provider ----
# Supported: smtp, sendgrid
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=manish050994@gmail.com
EMAIL_FROM_NAME=PIMS Notification

# SMTP settings (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# SendGrid settings (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# ---- SMS Provider ----
# Supported: twilio, msg91, mock
SMS_PROVIDER=mock
SMS_FROM_NUMBER=+10000000000

# Twilio settings (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# MSG91 settings (used when SMS_PROVIDER=msg91)
MSG91_API_KEY=
MSG91_SENDER_ID=PIMSAP
MSG91_ROUTE=4

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
