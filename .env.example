# PMIS Refactor — union of every service's env vars
# Each service reads its subset; unused vars are ignored.
# Copy to `.env` and fill in your local values.

# === Cross-service ===
ENV=development                                    # development | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=text                                    # text | json

# === Postgres (shared DB, per-service schemas) ===
DATABASE_URL=postgresql+psycopg2://pmis_app:changeme@postgres:5432/pmis
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://pmis_ddl:changeme@postgres:5432/pmis

# === JWT (shared SECRET_KEY across services) ===
SECRET_KEY=replace-me-with-a-256-bit-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_GRACE_SECONDS=120

# === ROOT_PATH (per Decision 8a; empty by default) ===
ROOT_PATH=

# === pmis-user-management ===
BOOTSTRAP_SUPERADMIN_LOGIN=superadmin
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_BOOTSTRAP_PASSWORD=                     # Q33: read by alembic bootstrap migration; unset after
REQUIRE_2FA=true
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=6
OTP_HASH_PEPPER=replace-me
PASSWORD_RESET_TTL_SECONDS=3600
UNIVERSAL_OTP_ENABLED=false                        # MUST be false in production (startup error otherwise per Q14)
UNIVERSAL_OTP_CODE=000000
NOTIFICATION_SERVICE_URL=http://pmis-notification-management:8002

# === pmis-project-management ===
SUBTASK_MAX_NESTING_DEPTH=5
ATTACHMENTS_STORAGE_BASE_PATH=/var/lib/pmis/attachments
ATTACHMENTS_MAX_BYTES=26214400                     # 25 MB (Q22)
ATTACHMENTS_ALLOWED_EXTENSIONS=pdf,docx,xlsx,txt,csv,jpg,jpeg,png,heic,mp4,webm,mov
ATTACHMENTS_SUBDIR_STRATEGY=year_month
ATTACHMENTS_RETENTION_DAYS=90
ATTACHMENTS_ON_UNAVAILABLE=fail
FILE_SERVER_PUBLIC_BASE_URL=
FILE_SERVER_LOCAL_FALLBACK_ENABLED=true
FILE_SERVER_BASE_URL=
FILE_SERVER_AUTH_TOKEN=

# === pmis-notification-management ===
EMAIL_PROVIDER=smtp                                # smtp | sendgrid
EMAIL_FROM_ADDRESS=no-reply@pims.example.com
EMAIL_FROM_NAME=PMIS Notification
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDGRID_API_KEY=
SMS_PROVIDER=mock                                  # mock | twilio | msg91
SMS_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MSG91_API_KEY=
MSG91_SENDER_ID=PMISAP
MSG91_ROUTE=4
CRON_SHARED_SECRET=
DEADLINE_WINDOW_DAYS=5

# === pmis-masters-management ===
DIVISION_DEFAULT_EMAIL=
DIVISION_DEFAULT_PHONE=

# === pmis-frontend (for reference; FE repo's own .env still applies) ===
VITE_API_BASE_URL=http://localhost:80
FRONTEND_BASE_URL=http://localhost:80

# === CORS (only used when ENV=development; nginx owns CORS in prod per Decision 8e) ===
CORS_ORIGINS=http://localhost:3000
