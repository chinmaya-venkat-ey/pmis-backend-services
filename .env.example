# pmis-contract-management — example local-dev env.

ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ROOT_PATH=
SERVICE_NAME=pmis-contract-management
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg2://pmis_app:changeme@localhost:5432/pmis
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://pmis_ddl:changeme@localhost:5432/pmis

# JWT verify-only. SECRET_KEY MUST be byte-identical to user-svc's.
SECRET_KEY=local-dev-secret-CHANGE-ME-min-32-chars-please-xxxxx
ALGORITHM=HS256

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Cross-service: pmis-project-management
# Evaluator resolves activity_id -> project_id from this service.
PROJECT_MANAGEMENT_BASE_URL=http://10.1.131.199/projects
PROJECT_MANAGEMENT_TIMEOUT_SECONDS=5.0

# ----------------------------------------------------------------------------
# SLA image attachments
# ----------------------------------------------------------------------------
# Storage resolution order (mirrors pmis-project-management):
#   1. FILE_STORE_SERVICE_URL  -> S3 microservice (pmis-file-store)
#   2. FILE_SERVER_LOCAL_FALLBACK_ENABLED=true -> local-disk / NFS mount
#   3. Neither set -> attachment routes return 503
#
# Pick ONE backend at a time. In prod that's usually the S3 microservice;
# in dev, comment FILE_STORE_SERVICE_URL out and let the local fallback
# take over.

# --- Option 1: NFS fallback (default, same mount as pmis-project-management) ---
# /mnt/pmis_files is bind-mounted from /srv/nfs/dev/pmis_files on the VM
# host (same as project-mgmt). Files land under
# /mnt/pmis_files/sla-attachments/ and are served by nginx at
# http://10.1.131.199/projects/files (the same block project-mgmt uses).
FILE_STORE_SERVICE_URL=
FILE_STORE_DEFAULT_FOLDER=sla-attachments
FILE_SERVER_LOCAL_FALLBACK_ENABLED=true
FILE_SERVER_LOCAL_DIR=/mnt/pmis_files
FILE_SERVER_PUBLIC_BASE_URL=http://10.1.131.199/projects/files

# --- Option 2: pmis-file-store S3 microservice ---
# Uncomment and point at the deployed file-svc when one exists. Takes
# priority over the NFS fallback above.
# FILE_STORE_SERVICE_URL=http://pmis-file-store:8005
# FILE_STORE_SERVICE_TOKEN=<service-to-service JWT>
# FILE_STORE_TIMEOUT_SECONDS=30.0

# --- Dev override (no NFS, no S3) ---
# Set the local dir to a writable spot on your laptop and clear the
# public base URL so the row stores a relative storage key. The
# attachment is then served by the file-svc /files/{key} route.
# FILE_SERVER_LOCAL_DIR=./uploads/sla-attachments
# FILE_SERVER_PUBLIC_BASE_URL=
