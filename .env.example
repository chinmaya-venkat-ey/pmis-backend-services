# pmis-user-service — environment template.
# Copy to .env and fill in real values. .env is gitignored.
#
# IMPORTANT: SECRET_KEY MUST be identical across pmis-user-service and
# pmis-backend. The user-service signs JWTs; the backend verifies them
# using the same secret. Any drift here breaks auth on the backend.

# ---- Database ----
# Same Postgres instance as the monolith. Both services share this DB.
DATABASE_URL=postgresql://pmis:admin123@localhost:5432/pmis

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars-shared-with-backend
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Bootstrap admin (only used if no admin user exists yet) ----
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin123

# ---- App ----
DEBUG=false
SERVICE_NAME=pmis-user-service
