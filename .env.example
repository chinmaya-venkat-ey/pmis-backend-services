# pmis-project-service — environment template.
# Copy to .env and fill in real values. .env is gitignored.
#
# IMPORTANT: SECRET_KEY MUST be identical across pmis-project-service,
# pmis-user-service, and pmis-backend (the monolith). User-service signs
# JWTs; this service verifies them using the same secret. Any drift here
# breaks auth on the project endpoints.

# ---- Database ----
# Same Postgres instance as the monolith and user-service. All three share this DB.
DATABASE_URL=postgresql://pmis:admin123@localhost:5432/pmis

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars-shared-with-all-services
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- File attachments (NFS-backed in prod) ----
# REQUIRED — local path where attachment bytes are stored. In production
# this MUST be the NFS mount point (same path as the monolith uses).
# In dev defaults to ./local_uploads inside the working directory.
ATTACHMENTS_STORAGE_BASE_PATH=./local_uploads

# Informational — surfaced in /health so support can verify which file
# store this instance is wired to. The app NEVER connects directly —
# the OS-level NFS mount does. Leave empty in dev.
ATTACHMENTS_NFS_SERVER=
ATTACHMENTS_NFS_EXPORT=

# Optional — sensible defaults exist in code. Set only to override.
ATTACHMENTS_MAX_BYTES=26214400
ATTACHMENTS_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,png,jpg,jpeg,gif,webp
ATTACHMENTS_SUBDIR_STRATEGY=year_month
ATTACHMENTS_RETENTION_DAYS=90
ATTACHMENTS_ON_UNAVAILABLE=fail

# ---- App ----
DEBUG=false
SERVICE_NAME=pmis-project-service
