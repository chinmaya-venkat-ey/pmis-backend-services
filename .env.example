# pmis-contract-management — example local-dev env.

ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ROOT_PATH=
SERVICE_NAME=pmis-contract-management
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg2://pmis_app:changeme@localhost:5432/pmis
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://pmis_ddl:changeme@localhost:5432/pmis

# JWT verify-only. SECRET_KEY MUST be byte-identical to user-svc's.
SECRET_KEY=local-dev-secret-CHANGE-ME-min-32-chars-please-xxxxx
ALGORITHM=HS256

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
