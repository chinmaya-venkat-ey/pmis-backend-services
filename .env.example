# ── Core ──────────────────────────────────────────────────────────────────────
ENV=development
SERVICE_NAME=pmis-file-store
LOG_LEVEL=INFO
LOG_FORMAT=text          # text | json

# ── Database ──────────────────────────────────────────────────────────────────
# Same shared PostgreSQL instance used by all PMIS microservices.
# The service creates and owns the `files` schema.
DATABASE_URL=postgresql+psycopg2://pmis_user:aadhaarpmis2026@localhost:5432/pmis_db
DATABASE_URL_MIGRATIONS=   # leave blank to use DATABASE_URL for migrations

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must match the SECRET_KEY used by pmis-user-management (token issuer).
SECRET_KEY=replace-me-with-same-key-as-user-svc
ALGORITHM=HS256

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Required for production. For local dev use MinIO or LocalStack.
S3_BUCKET_NAME=pmis-files
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# For MinIO / LocalStack dev override:
# S3_ENDPOINT_URL=http://localhost:9000

# Root key prefix inside the bucket. All objects will live under this path.
# Example: "pmis/prod" → bucket key = "pmis/prod/project-attachments/..."
S3_KEY_PREFIX=pmis

# How long (seconds) pre-signed GET URLs remain valid.
S3_PRESIGNED_URL_EXPIRES=3600

# If you serve the bucket through CloudFront or a public endpoint,
# set this to that base URL. When set, download responses return a
# permanent URL instead of a time-limited pre-signed URL.
# Example: https://files.pmis.example.com
S3_PUBLIC_URL_BASE=

# ── Upload constraints ────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400          # 25 MB
ALLOWED_EXTENSIONS=pdf,docx,xlsx,txt,csv,jpg,jpeg,png,heic,mp4,webm,mov

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── What you need to test S3 connectivity ─────────────────────────────────────
# Option A – Real AWS S3:
#   Fill S3_BUCKET_NAME, S3_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
#   The IAM user/role needs: s3:PutObject, s3:GetObject, s3:DeleteObject,
#   s3:HeadObject on the bucket ARN and s3:ListBucket on the bucket.
#
# Option B – MinIO (recommended for local dev):
#   docker run -d -p 9000:9000 -p 9001:9001 \
#     -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin \
#     quay.io/minio/minio server /data --console-address ":9001"
#   Then set:
#     S3_ENDPOINT_URL=http://localhost:9000
#     AWS_ACCESS_KEY_ID=minioadmin
#     AWS_SECRET_ACCESS_KEY=minioadmin
#     S3_BUCKET_NAME=pmis-files       (create via console at localhost:9001)
#
# Option C – AWS LocalStack:
#   docker run -d -p 4566:4566 localstack/localstack
#   S3_ENDPOINT_URL=http://localhost:4566
#   AWS_ACCESS_KEY_ID=test
#   AWS_SECRET_ACCESS_KEY=test
