# pmis-notification-management — example local-dev env.

ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ROOT_PATH=
SERVICE_NAME=pmis-notification-management
CORS_ORIGINS=http://localhost:3000

# notification-svc has zero owned tables but still needs DB access for the
# cross-schema reads (users.*, masters.notification_templates).
DATABASE_URL=postgresql+psycopg2://pmis_app:changeme@localhost:5432/pmis

# JWT verify-only. SECRET_KEY MUST be byte-identical to user-svc's.
SECRET_KEY=local-dev-secret-CHANGE-ME-min-32-chars-please-xxxxx
ALGORITHM=HS256

# === Email (SMTP) — dev: leave blank to no-op. ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=pmis-noreply@local.dev
SMTP_USE_TLS=true

# === SMS provider — dev: leave blank to no-op. ===
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=

# === Cron auth ===
CRON_SHARED_SECRET=local-dev-cron-secret-CHANGE-ME
