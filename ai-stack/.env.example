##############################################################
# .env  –  Copy this file to .env and fill in your values.
# NEVER commit .env to git (.gitignore already covers this)
##############################################################

# ─── LLM Backend ──────────────────────────────────────────
# Choose ONE backend: "ollama" or "vllm"
#
#   ollama  → pulls models automatically, zero sign-up needed
#             supports Qwen3, Llama3, Mistral and 100+ others
#   vllm    → faster for production, Qwen3 only (no token needed)
#             Llama 3.1 needs a HuggingFace account (see note below)
#
LLM_BACKEND=ollama

# ─── Model selection ──────────────────────────────────────
# These are used depending on which backend you chose above.

# --- Ollama model names (pulled automatically, no account) ---
# Uncomment one:
OLLAMA_MODEL=qwen3:8b
#OLLAMA_MODEL=qwen3:4b
#OLLAMA_MODEL=qwen3:14b
#OLLAMA_MODEL=llama3.1:8b      ← works without any token in Ollama

# --- vLLM model names (Qwen pulls automatically, no token) ---
# Only relevant when LLM_BACKEND=vllm. Uncomment one:
#LLM_MODEL=Qwen/Qwen3-4B
#LLM_MODEL=Qwen/Qwen3-8B
#LLM_MODEL=Qwen/Qwen3-14B
#LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct  ← needs HF token (see note)

# NOTE on Llama 3.1 with vLLM:
#   If you choose Llama with vLLM you must accept the license on
#   huggingface.co/meta-llama/Meta-Llama-3.1-8B-Instruct and set:
#   HF_TOKEN=hf_your_token_here
#   With Ollama backend, Llama pulls freely with no token at all.
HF_TOKEN=

# Max context length in tokens (reduce to 2048 if RAM is tight)
LLM_MAX_CTX=4096

# RAM limit for the LLM container
VLLM_MEM_LIMIT=18g

# ─── Qdrant ───────────────────────────────────────────────
# Leave empty = no auth (fine for a private server)
QDRANT_API_KEY=

# ─── PostgreSQL (your existing DB on another server) ───────
# Paste your connection string here.
# Format: postgresql://USERNAME:PASSWORD@HOST_IP:PORT/DATABASE_NAME
# Example: postgresql://appuser:secret@192.168.1.50:5432/production_db
DATABASE_URL=postgresql+psycopg2://pmis_user:aadhaarpmis2026@10.1.131.199:5432/pmis_db

# ─── File Storage ─────────────────────────────────────────
# Choose ONE. Leave the other section blank.

# Option A – NFS (network file share already mounted on this server)
NFS_MOUNT_PATH=/mnt/nfs

# Option B – S3 or MinIO
S3_ENDPOINT=https://s3.amazonaws.com    # MinIO example: http://192.168.1.60:9000
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY
S3_REGION=ap-south-1

# ─── FastAPI App ──────────────────────────────────────────
REPO_URL=https://github.com/YOUR_ORG/YOUR_REPO.git
REPO_BRANCH=main
FASTAPI_PORT=8080
FASTAPI_IMAGE=fastapi-app:latest

# ─── App secrets ──────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
APP_ENV=production
