##############################################################
# AI Stack – docker-compose.yml
#
# LLM_BACKEND in .env controls which LLM service runs:
#   ollama  → pulls models automatically, no account needed
#   vllm    → faster, Qwen3 needs no token; Llama needs HF_TOKEN
#
# External services (not in Docker here):
#   PostgreSQL – connect via DATABASE_URL in .env
#   NFS / S3   – configured via NFS_MOUNT_PATH or S3_* in .env
##############################################################


networks:
  ai-net:
    driver: bridge

volumes:
  qdrant_data:
  ollama_models:        # Ollama keeps models here across restarts
  embedding_models:
  hf_model_cache:       # vLLM / HuggingFace model cache
  paddle_models:

services:

  # ═══════════════════════════════════════════════════════
  # OPTION A – Ollama  (LLM_BACKEND=ollama in .env)
  #   • No HuggingFace account needed
  #   • Pulls the model automatically on first start
  #   • OpenAI-compatible API on port 11434
  #   • Your FastAPI calls http://ollama:11434
  # ═══════════════════════════════════════════════════════
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    restart: unless-stopped
    networks:
      - ai-net
    ports:
      - "11434:11434"
    volumes:
      - ollama_models:/root/.ollama
    # Pull the chosen model automatically when the container starts
    entrypoint: >
      sh -c "ollama serve &
             sleep 5 &&
             ollama pull ${OLLAMA_MODEL:-qwen3:8b} &&
             wait"
    deploy:
      resources:
        limits:
          memory: ${VLLM_MEM_LIMIT:-18g}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:11434/api/tags"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 180s    # first pull can take several minutes

  # ═══════════════════════════════════════════════════════
  # OPTION B – vLLM  (LLM_BACKEND=vllm in .env)
  #   • Qwen3 models download automatically, no token needed
  #   • Llama 3.1 requires HF_TOKEN set in .env
  #   • OpenAI-compatible API on port 8000
  #   • Your FastAPI calls http://vllm:8000
  # ═══════════════════════════════════════════════════════
  vllm:
    image: vllm/vllm-openai:latest
    container_name: vllm
    restart: unless-stopped
    networks:
      - ai-net
    ports:
      - "8000:8000"
    volumes:
      - hf_model_cache:/root/.cache/huggingface
    environment:
      # Only needed if you pick a gated model like Llama 3.1
      - HUGGING_FACE_HUB_TOKEN=${HF_TOKEN:-}
    command: >
      --model ${LLM_MODEL:-Qwen/Qwen3-8B}
      --host 0.0.0.0
      --port 8000
      --max-model-len ${LLM_MAX_CTX:-4096}
      --dtype float16
    deploy:
      resources:
        limits:
          memory: ${VLLM_MEM_LIMIT:-18g}
    shm_size: "2g"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 180s

  # ─────────────────────────────────────────────
  # Embedding service – BAAI/bge-large-en-v1.5
  # No token needed – this model is fully open.
  # REST API on port 8001
  # ─────────────────────────────────────────────
  embedding:
    image: ollama/ollama:latest
    container_name: embedding
    restart: unless-stopped
    networks:
      - ai-net
    ports:
      - "8001:11434"
    volumes:
      - embedding_models:/root/.ollama
    entrypoint: >
      sh -c "ollama serve &
             sleep 8 &&
             ollama pull nomic-embed-text &&
             wait"
    deploy:
      resources:
        limits:
          memory: 4g
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:11434/api/tags"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

  # ─────────────────────────────────────────────
  # Qdrant – Vector database
  # REST on 6333, gRPC on 6334
  # ─────────────────────────────────────────────
  qdrant:
    image: qdrant/qdrant:latest
    container_name: qdrant
    restart: unless-stopped
    networks:
      - ai-net
    ports:
      - "6333:6333"
      - "6334:6334"
    volumes:
      - qdrant_data:/qdrant/storage
    environment:
      - QDRANT__SERVICE__API_KEY=${QDRANT_API_KEY:-}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:6333/healthz"]
      interval: 20s
      timeout: 5s
      retries: 5

  # ─────────────────────────────────────────────
  # PaddleOCR – Document / image text extraction
  # REST API on port 8002
  # ─────────────────────────────────────────────
  paddleocr:
    image: python:3.11-slim
    container_name: paddleocr
    restart: unless-stopped
    networks:
      - ai-net
    ports:
      - "8002:8002"
    volumes:
      - paddle_models:/root/.paddleocr
      - ./scripts/paddle_server.py:/app/paddle_server.py
    working_dir: /app
    command: >
      bash -c "pip install paddlepaddle paddleocr fastapi uvicorn python-multipart --quiet &&
               python paddle_server.py"
    deploy:
      resources:
        limits:
          memory: 4g
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8002/health"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 360s

  # ─────────────────────────────────────────────
  # FastAPI – Your team's application
  # Built from your git repo by deploy.sh
  # ─────────────────────────────────────────────
  fastapi:
    image: ${FASTAPI_IMAGE:-fastapi-app:latest}
    container_name: fastapi
    restart: unless-stopped
    networks:
      - ai-net
    ports:
      - "${FASTAPI_PORT:-8080}:8080"
    env_file:
      - .env
    environment:
      # ── LLM endpoint ──────────────────────────────────
      # Both Ollama and vLLM speak the OpenAI API format.
      # Your code uses VLLM_BASE_URL regardless of backend.
      - VLLM_BASE_URL=${LLM_BASE_URL:-http://ollama:11434}
      - LLM_MODEL=${OLLAMA_MODEL:-qwen3:8b}
      # ── Other internal services ───────────────────────
      - EMBEDDING_URL=http://embedding:11434
      - QDRANT_URL=http://qdrant:6333
      - OCR_URL=http://paddleocr:8002
      # ── External services (from .env) ─────────────────
      - DATABASE_URL=${DATABASE_URL}
      - S3_ENDPOINT=${S3_ENDPOINT:-}
      - S3_BUCKET=${S3_BUCKET:-}
      - S3_ACCESS_KEY=${S3_ACCESS_KEY:-}
      - S3_SECRET_KEY=${S3_SECRET_KEY:-}
      - NFS_MOUNT_PATH=${NFS_MOUNT_PATH:-/mnt/nfs}
    volumes:
      - ${NFS_MOUNT_PATH:-/mnt/nfs}:${NFS_MOUNT_PATH:-/mnt/nfs}:ro
    depends_on:
      embedding:
        condition: service_healthy
      qdrant:
        condition: service_healthy
      paddleocr:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3
