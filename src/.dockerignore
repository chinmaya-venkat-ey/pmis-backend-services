# Keep the Docker build context lean.
# Everything listed here is excluded from what's sent to the daemon.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenv — never ship a venv into the image.
venv/
.venv/
env/

# Environment — real secrets are injected via compose env_file at runtime,
# not baked into the image.
.env
.env.local

# Tests — not needed in prod image.
tests/

# Git + editor
.git/
.gitignore
.vscode/
.idea/
*.swp

# Docs
README.md
*.md

# Logs
*.log
server.log

# OS
.DS_Store
Thumbs.db
